<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.meridian.payments</groupId>
    <artifactId>payment-intake</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>payment-intake</name>
    <description>Intake of premium payment notifications (Quetzal MX, Andina CO): webhook to canonical event</description>

    <properties>
        <java.version>21</java.version>
        <json-schema-validator.version>1.5.1</json-schema-validator.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Validates every canonical event against the published JSON Schema before it is published -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Single source of truth: the event schema is read from docs/api, not copied by hand -->
            <resource>
                <directory>${project.basedir}/../docs/api/events</directory>
                <targetPath>schemas</targetPath>
                <includes>
                    <include>premium-payment.schema.json</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- Provider samples and their exact raw bytes, used as contract tests -->
            <testResource>
                <directory>${project.basedir}/../reference/providers</directory>
                <targetPath>providers</targetPath>
                <includes>
                    <include>quetzal-mx/samples/*.json</include>
                    <include>andina-co/samples/*.json</include>
                </includes>
            </testResource>
        </testResources>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
