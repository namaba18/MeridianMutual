<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.meridian.payments</groupId>
    <artifactId>payment-intake</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>payment-intake</name>
    <description>Intake of premium payment notifications (Quetzal MX, Andina CO): webhook to canonical event</description>

    <properties>
        <java.version>21</java.version>
        <!-- Security overrides of versions managed by Spring Boot 3.5.16, found by the CI image scan
             (Trivy). Remove each one when Spring Boot manages the same or a newer version. -->
        <!-- Tomcat: CVE-2026-55276, CVE-2026-53404 (fixed 10.1.56), CVE-2026-65182, CVE-2026-65905,
             CVE-2026-68525 (fixed 10.1.58). Boot 3.5.16 manages 10.1.55. -->
        <tomcat.version>10.1.62</tomcat.version>
        <!-- Jackson: CVE-2026-68497 (fixed 2.21.6), CVE-2026-89407, CVE-2026-89425, CVE-2026-91776,
             CVE-2026-91777 (fixed 2.21.7). Boot 3.5.16 manages 2.21.4. -->
        <jackson-bom.version>2.21.8</jackson-bom.version>
        <json-schema-validator.version>1.5.1</json-schema-validator.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Validates every canonical event against the published JSON Schema before it is published -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Single source of truth: the event schema is read from docs/api, not copied by hand -->
            <resource>
                <directory>${project.basedir}/../docs/api/events</directory>
                <targetPath>schemas</targetPath>
                <includes>
                    <include>premium-payment.schema.json</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- Provider samples and their exact raw bytes, used as contract tests -->
            <testResource>
                <directory>${project.basedir}/../reference/providers</directory>
                <targetPath>providers</targetPath>
                <includes>
                    <include>quetzal-mx/samples/*.json</include>
                    <include>andina-co/samples/*.json</include>
                </includes>
            </testResource>
        </testResources>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
